<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net462</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<Nullable>disable</Nullable>
		<AssemblyName>NCache.OSS.Hangfire</AssemblyName>
		<RootNamespace>NCache.OSS.Hangfire</RootNamespace>
		<Description>NCache OSS storage provider for Hangfire.</Description>
		<Version>5.3.6.2</Version>
	</PropertyGroup>
	
	<ItemGroup>
		<PackageReference Include="Alachisoft.NCache.Opensource.SDK" Version="5.3.6.2" />
		<PackageReference Include="Hangfire.Core" Version="1.8.24" />
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.0" />
		<PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
	</ItemGroup>
	
	<ItemGroup Condition="'$(TargetFramework)' == 'net462'">
		<PackageReference Include="System.ValueTuple" Version="4.6.2" />
	</ItemGroup>
	
	<ItemGroup>
	  <ProjectReference Include="..\..\Extensions\Alachisoft.NCache.Client.Extension\Alachisoft.NCache.Client.Extension.csproj" />
	</ItemGroup>
	
	<ItemGroup>
		<None Update="client.ncconf">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="config.ncconf">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>
 
	 
</Project>