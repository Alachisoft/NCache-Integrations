<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>

		<!-- Versioning -->
		<Version>5.3.603</Version>
		<AssemblyVersion>5.3.0.0</AssemblyVersion>
		<FileVersion>5.3.603</FileVersion>

		<!-- The test project lives under Tests/; keep its sources out of this library -->
		<DefaultItemExcludes>$(DefaultItemExcludes);Tests/**</DefaultItemExcludes>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Alachisoft.NCache.Opensource.SDK" Version="5.3.603" />
		<PackageReference Include="DistributedLock.Core" Version="1.0.9" />
		<PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.12" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="../Extensions/Alachisoft.NCache.Client.Extension/Alachisoft.NCache.Client.Extension.csproj" />
	</ItemGroup>

</Project>
