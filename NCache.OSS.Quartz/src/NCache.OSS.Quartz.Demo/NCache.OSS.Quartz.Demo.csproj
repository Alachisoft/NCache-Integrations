<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NCache.OSS.Quartz.Demo</RootNamespace>
    <!-- The Quartz dashboard is Blazor Server; a project without .razor files needs this for its framework script. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <!-- Brings Quartz.AspNetCore (and Quartz) along. -->
    <PackageReference Include="Quartz.Dashboard" Version="4.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NCache.OSS.Quartz\NCache.OSS.Quartz.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Reference only (see the comment inside). The NCache client honours a client.ncconf in
      the current or base directory, so the template is deliberately not named client.ncconf.
    -->
    <None Update="client.ncconf.sample" CopyToOutputDirectory="Never" />
  </ItemGroup>

</Project>
